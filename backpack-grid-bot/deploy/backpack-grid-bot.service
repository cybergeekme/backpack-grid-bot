[Unit]
Description=Backpack Grid Bot v2 (Rust shadow runtime)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=backpack-grid-bot
Group=backpack-grid-bot
WorkingDirectory=/opt/backpack-grid-bot/rust
Environment=GRID_RUN_ONCE=false
Environment=GRID_RUNTIME_STATE_PATH=/var/lib/backpack-grid-bot/runtime/state.json
Environment=GRID_SHADOW_INTERVAL_MS=15000
EnvironmentFile=-/etc/backpack-grid-bot/backpack-grid-bot.env
ExecStart=/opt/backpack-grid-bot/rust/target/release/backpack-grid-bot
Restart=on-failure
RestartSec=5
UMask=007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=backpack-grid-bot
ReadWritePaths=/var/lib/backpack-grid-bot

[Install]
WantedBy=multi-user.target
