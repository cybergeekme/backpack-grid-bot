# Development / local validation defaults
GRID_USE_BACKPACK=false
# false = Backpack read-only mode, true = allow order placement/cancel mutations
BACKPACK_ENABLE_LIVE=false
BACKPACK_ENABLE_WS=false

GRID_SYMBOL=ETH_USDC_PERP
GRID_LEVELS=3
GRID_SPACING_BPS=50
GRID_ORDER_SIZE=0.01
GRID_MAX_POSITION_ABS=0.05
GRID_MODE=neutral
GRID_ACTIVE_LEVELS=3
GRID_SHORT_BIAS_SELL_RATIO=3
# Optional bounded grid mode; when both are set the engine distributes GRID_LEVELS across this full range.
GRID_MIN_PRICE=
GRID_MAX_PRICE=
# Startup validates this against Backpack account leverageLimit; actual per-market leverage still needs to be set on the exchange side.
GRID_LEVERAGE=1
GRID_KILL_SWITCH=false

GRID_SERVICE_LOOP_MS=5000
GRID_SERVICE_RECONCILE_MS=15000
GRID_SERVICE_ERROR_THRESHOLD=3
GRID_SERVICE_OUT_OF_RANGE_BPS=75
GRID_SERVICE_DRY_RUN_MS=20000
GRID_MOCK_PRICE_STEP=100

GRID_DB_PATH=./var/backpack-grid-bot.sqlite
GRID_SERVICE_NAME=backpack-grid-bot-dev

TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_LEVEL=warn
TELEGRAM_ALERT_DEDUP_MS=300000
TELEGRAM_NOTIFY_FILLS=false

BACKPACK_API_KEY=
BACKPACK_API_SECRET=
BACKPACK_WINDOW_MS=5000
BACKPACK_WS_URL=wss://ws.backpack.exchange
