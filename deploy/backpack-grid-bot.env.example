# backpack-grid-bot v2 / Rust shadow runtime
# Fill secrets locally on the server. Do not commit real values.

GRID_SYMBOL=ETH_USDC_PERP
GRID_LEVELS=5
GRID_SPACING_BPS=35
GRID_ORDER_SIZE=0.003
GRID_MAX_POSITION_ABS=0.02
GRID_MODE=short_only
GRID_ACTIVE_LEVELS=5
GRID_SHORT_BIAS_SELL_RATIO=3
GRID_MIN_PRICE=
GRID_MAX_PRICE=
GRID_LEVERAGE=10
GRID_KILL_SWITCH=false
GRID_QUOTE_ASSET=USDC

GRID_RUN_ONCE=false
GRID_SHADOW_INTERVAL_MS=15000
GRID_RUNTIME_STATE_PATH=/var/lib/backpack-grid-bot/runtime/state.json

BACKPACK_ENABLE_WS=true
BACKPACK_WS_URL=wss://ws.backpack.exchange
BACKPACK_API_BASE_URL=https://api.backpack.exchange
BACKPACK_API_KEY=
BACKPACK_API_SECRET=
