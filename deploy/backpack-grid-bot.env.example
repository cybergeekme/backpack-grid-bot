# Production env template for /etc/backpack-grid-bot/backpack-grid-bot.env
# Fill in secrets locally on the server. Do NOT commit real values.

GRID_USE_BACKPACK=false
# false = Backpack read-only mode, true = allow order placement/cancel mutations
BACKPACK_ENABLE_LIVE=false
BACKPACK_ENABLE_WS=false

GRID_SYMBOL=ETH_USDC_PERP
GRID_LEVELS=3
GRID_SPACING_BPS=50
GRID_ORDER_SIZE=0.01
GRID_MAX_POSITION_ABS=0.05
GRID_KILL_SWITCH=false

GRID_SERVICE_LOOP_MS=15000
GRID_SERVICE_RECONCILE_MS=60000
GRID_SERVICE_ERROR_THRESHOLD=3
GRID_SERVICE_OUT_OF_RANGE_BPS=75
GRID_MOCK_PRICE_STEP=100

GRID_DB_PATH=/var/lib/backpack-grid-bot/backpack-grid-bot.sqlite
GRID_SERVICE_NAME=backpack-grid-bot-prod

TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_LEVEL=warn
TELEGRAM_ALERT_DEDUP_MS=300000
TELEGRAM_NOTIFY_FILLS=false

# Only turn these on after read-only validation / tiny-size live validation.
BACKPACK_API_KEY=
BACKPACK_API_SECRET=
BACKPACK_WINDOW_MS=5000
BACKPACK_WS_URL=wss://ws.backpack.exchange
